# ---------------------------------------------------------
# SprigAI - Smart Crop Guardian - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit your real ".env" file to Git.
# ---------------------------------------------------------

# Django core settings
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (MySQL via XAMPP / phpMyAdmin)
DB_ENGINE=django.db.backends.mysql
DB_NAME=sprigai_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Hosted MySQL: enable verified TLS when required by your provider.
DB_SSL=False
# Optional path to your provider's CA certificate:
DB_SSL_CA=
# Comma-separated full HTTPS origins for your deployed/custom domains.
CSRF_TRUSTED_ORIGINS=

# AI Chatbot provider: "gemini" or "openai"
CHATBOT_PROVIDER=gemini

# Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI model files base directory (relative to project root by default)
AI_MODELS_DIR=ai_models

# Media / uploads
MAX_UPLOAD_SIZE_MB=8

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
